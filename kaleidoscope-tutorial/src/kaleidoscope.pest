WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "#" ~ (!("\n" | "\r") ~ ANY)* }

// Chapter 1: expose the grammar as a flat token stream.
token_stream = { SOI ~ token* ~ EOI }
token = _{
    keyword_def
    | keyword_extern
    | keyword_if
    | keyword_then
    | keyword_else
    | keyword_for
    | keyword_in
    | keyword_binary
    | keyword_unary
    | number
    | identifier
    | character
}

// Atomic keyword rules prevent Pest's implicit whitespace skipping from
// occurring before the identifier-boundary check.
keyword_def = @{ "def" ~ !ASCII_ALPHANUMERIC }
keyword_extern = @{ "extern" ~ !ASCII_ALPHANUMERIC }
keyword_if = @{ "if" ~ !ASCII_ALPHANUMERIC }
keyword_then = @{ "then" ~ !ASCII_ALPHANUMERIC }
keyword_else = @{ "else" ~ !ASCII_ALPHANUMERIC }
keyword_for = @{ "for" ~ !ASCII_ALPHANUMERIC }
keyword_in = @{ "in" ~ !ASCII_ALPHANUMERIC }
keyword_binary = @{ "binary" ~ !ASCII_ALPHANUMERIC }
keyword_unary = @{ "unary" ~ !ASCII_ALPHANUMERIC }

// Keep Chapter 1's identifier syntax deliberately small and predictable.
identifier = @{
    !("def" ~ !ASCII_ALPHANUMERIC)
    ~ !("extern" ~ !ASCII_ALPHANUMERIC)
    ~ !("if" ~ !ASCII_ALPHANUMERIC)
    ~ !("then" ~ !ASCII_ALPHANUMERIC)
    ~ !("else" ~ !ASCII_ALPHANUMERIC)
    ~ !("for" ~ !ASCII_ALPHANUMERIC)
    ~ !("in" ~ !ASCII_ALPHANUMERIC)
    ~ !("binary" ~ !ASCII_ALPHANUMERIC)
    ~ !("unary" ~ !ASCII_ALPHANUMERIC)
    ~ ASCII_ALPHA
    ~ ASCII_ALPHANUMERIC*
}

// Unlike the tutorial's permissive [0-9.]+ loop, this rule describes one
// decimal point at most. Signs remain punctuation and are parsed as operators.
number = @{ (ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)?) | ("." ~ ASCII_DIGIT+) }

// Chapter 1 leaves operators and delimiters as their literal characters.
character = @{ ANY }

// Chapter 2: parse complete programs. Function parameters are whitespace-
// separated, as in the LLVM tutorial; call arguments are comma-separated.
program = { SOI ~ top_level* ~ EOI }
top_level = _{ definition | extern_declaration | top_level_expression | empty_statement }
empty_statement = { ";" }

definition = { keyword_def ~ prototype ~ expression ~ ";"? }
extern_declaration = { keyword_extern ~ prototype ~ ";"? }
top_level_expression = { expression ~ ";"? }
prototype = { ordinary_prototype | unary_prototype | binary_prototype }
ordinary_prototype = { identifier ~ "(" ~ identifier* ~ ")" }
unary_prototype = { keyword_unary ~ operator ~ "(" ~ identifier* ~ ")" }
binary_prototype = { keyword_binary ~ operator ~ number? ~ "(" ~ identifier* ~ ")" }

expression = { unary_expression ~ (operator ~ unary_expression)* }
unary_expression = { operator* ~ primary }
primary = _{ number | parenthesized | if_expression | for_expression | identifier_expression }
parenthesized = { "(" ~ expression ~ ")" }
if_expression = {
    keyword_if ~ expression ~ keyword_then ~ expression ~ keyword_else ~ expression
}
for_expression = {
    keyword_for ~ identifier ~ "=" ~ expression ~ "," ~ expression
    ~ ("," ~ expression)? ~ keyword_in ~ expression
}
identifier_expression = { identifier ~ call_suffix? }
call_suffix = { "(" ~ argument_list? ~ ")" }
argument_list = { expression ~ ("," ~ expression)* }

// A dot followed by a digit starts a number (`.5`), not an operator. Delimiters
// and `#` are excluded because they already have syntactic roles.
operator = @{
    "!" | "$" | "%" | "&" | "*" | "+" | "-" | ("." ~ !ASCII_DIGIT)
    | "/" | ":" | "<" | "=" | ">" | "?" | "@" | "\\" | "^" | "|" | "~"
}
